<div class="max-w-4xl mx-auto p-6 mt-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-800">⛳️ ゴルフカルテ一覧</h1>
    <%= link_to "＋ 新しいカルテを書く", new_record_path, class: "bg-green-700 hover:bg-green-800 text-white font-bold py-2 px-4 rounded-lg shadow transition" %>
  </div>

  <% if @records.present? %>
    <div class="grid gap-4">
      <% @records.each do |record| %>
        <div class="bg-white p-5 rounded-lg shadow border border-gray-200">
          <div class="flex justify-between items-start">
            <div>
              <span class="text-xs text-gray-500 font-semibold"><%= record.played_on %></span>
              <h2 class="text-xl font-bold text-gray-800 mt-1"><%= record.golf_course_name %></h2>
            </div>
            <span class="text-yellow-500 font-bold text-lg"><%= record.satisfaction.sub("star", "⭐️ ") %></span>
          </div>

          <div class="flex gap-4 mt-3 text-sm text-gray-600">
            <% if record.score_18h.present? %>
              <p>18Hスコア: <span class="font-bold text-gray-800"><%= record.score_18h %></span></p>
            <% end %>
            <% if record.score_9h.present? %>
              <p>9Hスコア: <span class="font-bold text-gray-800"><%= record.score_9h %></span></p>
            <% end %>
          </div>

          <% if record.memo.present? %>
            <p class="text-sm text-gray-700 mt-3 bg-gray-50 p-3 rounded border border-gray-100"><%= record.memo %></p>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-12 bg-white rounded-lg shadow border border-gray-100">
      <p class="text-gray-500 mb-4">まだカルテが登録されていません🏌️‍♀️</p>
      <%= link_to "最初のカルテを登録してみる", new_record_path, class: "text-green-700 font-bold hover:underline" %>
    </div>
  <% end %>
</div>