<div class="max-w-4xl mx-auto p-6 mt-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-800">⛳️ ゴルフカルテ一覧</h1>
    <%= link_to "＋ 新しいカルテを書く", new_record_path, class: "bg-green-700 hover:bg-green-800 text-white font-bold py-2 px-4 rounded-lg shadow transition" %>
  </div>

  <% if @records.present? %>
    <div class="grid gap-4">
      <% @records.each do |record| %>
        <div class="bg-white p-5 rounded-lg shadow border border-gray-200">
          <div class="flex justify-between items-start">
            <div>
              <span class="text-xs text-gray-500 font-semibold"><%= record.played_on.strftime("%Y年%m月%d日") rescue record.played_on %></span>
              <h2 class="text-xl font-bold text-gray-800 mt-1 hover:text-green-700 transition">
                <%= link_to record.golf_course_name, record_path(record) %>
              </h2>
            </div>
            <span class="text-yellow-500 font-bold text-lg"><%= record.satisfaction.sub("star", "⭐️ ") %></span>
          </div>

          <!-- スコア表示エリア（ハーフ・換算対応） -->
          <div class="flex items-center gap-3 mt-3 text-sm text-gray-600 flex-wrap">
            <% if record.score_18h.present? %>
              <div class="flex items-center gap-1.5">
                <span class="text-xs text-gray-500">スコア:</span>
                <span class="font-bold text-gray-900 text-base"><%= record.score_18h %></span>
                <span class="text-xs bg-slate-100 text-slate-600 px-1.5 py-0.5 rounded font-medium">18H</span>
              </div>
            <% elsif record.score_9h.present? %>
              <div class="flex items-center gap-2 flex-wrap">
                <div class="flex items-center gap-1">
                  <span class="text-xs text-gray-500">スコア:</span>
                  <span class="font-bold text-gray-900 text-base"><%= record.score_9h %></span>
                  <span class="text-xs bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full font-semibold">9Hハーフ</span>
                </div>
                <span class="text-xs text-gray-500 bg-gray-50 px-2 py-0.5 rounded border border-gray-100">
                  18H換算目安スコア: <strong class="text-gray-700 font-bold"><%= record.converted_score_18h %></strong>
                </span>
              </div>
            <% end %>
          </div>

          <!-- 本音メモ（短縮表示） -->
          <% if record.memo.present? %>
            <p class="text-sm text-gray-700 mt-3 bg-gray-50 p-3 rounded border border-gray-100 line-clamp-2">
              <%= record.memo %>
            </p>
          <% end %>

          <!-- 右下リンク -->
          <div class="mt-4 pt-3 border-t border-gray-100 flex justify-end">
            <%= link_to "詳細を見る →", record_path(record), class: "text-sm font-semibold text-green-700 hover:text-green-900 transition" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-12 bg-white rounded-lg shadow border border-gray-100">
      <p class="text-gray-500 mb-4">まだカルテが登録されていません🏌️‍♀️</p>
      <%= link_to "最初のカルテを登録してみる", new_record_path, class: "text-green-700 font-bold hover:underline" %>
    </div>
  <% end %>
</div>