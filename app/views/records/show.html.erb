<div class="max-w-2xl mx-auto py-8 px-4">
  <!-- 戻るリンク -->
  <div class="mb-6">
    <%= link_to "← カルテ一覧に戻る", records_path, class: "text-emerald-700 hover:text-emerald-900 text-sm font-semibold transition" %>
  </div>

  <!-- カルテ詳細カード -->
  <div class="bg-white rounded-2xl shadow-lg border border-slate-100 overflow-hidden">
    <!-- ヘッダーエリア -->
    <div class="bg-emerald-800 text-white p-6">
      <div class="flex items-center justify-between text-emerald-200 text-sm mb-2">
        <span class="flex items-center gap-1">
          📅 <%= @record.played_on.strftime("%Y年%m月%d日") %>
        </span>
        <span class="bg-emerald-900/60 px-3 py-1 rounded-full text-xs font-semibold text-emerald-100">
          カルテ詳細
        </span>
      </div>
      <h1 class="text-2xl font-bold tracking-wide">
        ⛳️ <%= @record.golf_course_name %>
      </h1>
    </div>

    <!-- コンテンツエリア -->
    <div class="p-6 space-y-6">
      <!-- 満足度 & スコア -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- 満足度 -->
        <div class="bg-slate-50 p-4 rounded-xl border border-slate-100">
          <span class="text-xs text-slate-500 block mb-1">総合満足度</span>
          <div class="text-amber-500 text-lg font-bold">
            <%= "⭐️" * @record.satisfaction_before_type_cast.to_i %>
            <span class="text-sm text-slate-600 font-normal ml-1">
              (<%= @record.satisfaction_i18n rescue @record.satisfaction %>)
            </span>
          </div>
        </div>

        <!-- スコア -->
        <div class="bg-slate-50 p-4 rounded-xl border border-slate-100">
          <span class="text-xs text-slate-500 block mb-1">スコア</span>
          <div class="text-slate-800 font-bold text-lg">
            <% if @record.score_18h.present? %>
              <%= @record.score_18h %> <span class="text-xs text-slate-500 font-normal">(18H)</span>
            <% elsif @record.score_9h.present? %>
              <%= @record.score_9h %> <span class="text-xs text-slate-500 font-normal">(9H)</span>
            <% else %>
              <span class="text-slate-400 text-sm font-normal">未入力</span>
            <% end %>
          </div>
        </div>
      </div>

      <!-- コース評価項目（難易度 / 食事 / 施設） -->
      <div class="border-t border-slate-100 pt-5">
        <h2 class="text-sm font-bold text-slate-700 mb-3">🏌️ コースの印象・評価</h2>
        <div class="grid grid-cols-3 gap-3 text-center">
          <div class="bg-emerald-50/50 p-3 rounded-xl border border-emerald-100/60">
            <span class="text-xs text-slate-500 block mb-1">コース難易度</span>
            <span class="text-sm font-semibold text-emerald-900">
              <%= @record.difficulty.presence || "未入力" %>
            </span>
          </div>
          <div class="bg-emerald-50/50 p-3 rounded-xl border border-emerald-100/60">
            <span class="text-xs text-slate-500 block mb-1">レストラン/食事</span>
            <span class="text-sm font-semibold text-emerald-900">
              <%= @record.food.presence || "未入力" %>
            </span>
          </div>
          <div class="bg-emerald-50/50 p-3 rounded-xl border border-emerald-100/60">
            <span class="text-xs text-slate-500 block mb-1">設備・クラブハウス</span>
            <span class="text-sm font-semibold text-emerald-900">
              <%= @record.facility.presence || "未入力" %>
            </span>
          </div>
        </div>
      </div>

      <!-- 本音メモ -->
      <div class="border-t border-slate-100 pt-5">
        <h2 class="text-sm font-bold text-slate-700 mb-3">📝 本音メモ・振り返り</h2>
        <div class="bg-amber-50/60 border border-amber-100 rounded-xl p-4 text-slate-700 leading-relaxed text-sm whitespace-pre-wrap">
          <% if @record.memo.present? %>
            <%= @record.memo %>
          <% else %>
            <span class="text-slate-400 italic">メモはありません</span>
          <% end %>
        </div>
      </div>

      <!-- アクションボタン枠（「編集する」＋「削除する」ボタン） -->
<div class="border-t border-slate-100 pt-5 flex items-center justify-between">
        <%= link_to "← 一覧へ戻る", records_path, class: "px-4 py-2 text-sm text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-lg transition" %>
        <div class="flex items-center gap-3">
          <!-- 編集ボタン -->
          <%= link_to "✏️ 編集する", edit_record_path(@record), class: "px-4 py-2 text-sm font-bold text-white bg-emerald-700 hover:bg-emerald-800 rounded-lg shadow transition" %>
          <%= link_to "🗑️ 削除する", record_path(@record),
                      data: { turbo_method: :delete, turbo_confirm: "本当にこのカルテを削除しますか？" },
                      class: "px-4 py-2 text-sm font-bold text-red-600 bg-red-50 hover:bg-red-100 rounded-lg border border-red-200 transition cursor-pointer" %>
        </div>
      </div>
    </div>
  </div>
</div>