<div class="max-w-3xl mx-auto py-8 px-4">
  <!-- 戻るリンク -->
  <div class="mb-6">
    <%= link_to "← カルテ一覧に戻る", records_path, class: "text-emerald-700 hover:text-emerald-900 text-sm font-semibold transition" %>
  </div>

  <div class="bg-white rounded-3xl shadow-xl border border-slate-100 overflow-hidden">
    <!-- ヘッダーエリア -->
    <div class="bg-gradient-to-r from-emerald-800 to-emerald-700 text-white p-6 sm:p-8">
      <div class="flex items-center justify-between text-emerald-200 text-sm mb-3 flex-wrap gap-2">
        <span class="flex items-center gap-2">
          <%= @record.played_on.strftime("%Y年%m月%d日") %>
          <!-- 休日（薄い赤/ピンク） / 平日（薄いブルー） -->
          <% if @record.played_on.saturday? || @record.played_on.sunday? %>
            <span class="bg-rose-100 text-rose-800 border border-rose-200 px-2.5 py-0.5 rounded-full text-xs font-bold">休日 ㊗️</span>
          <% else %>
            <span class="bg-sky-100 text-sky-800 border border-sky-200 px-2.5 py-0.5 rounded-full text-xs font-bold">平日 🔘</span>
          <% end %>

          <% if @record.weather.present? %>
            <span class="bg-emerald-900/70 px-2.5 py-0.5 rounded-full text-xs text-white border border-emerald-600/40">
              <%= @record.weather %>
            </span>
          <% end %>
        </span>
      </div>

      <h1 class="text-2xl sm:text-3xl font-bold tracking-wide">
        <%= @record.golf_course_name %>
      </h1>

      <!-- ヘッダー下部：同伴者・料金・ティー・進行状況 -->
      <div class="flex items-center gap-2.5 mt-3.5 text-xs flex-wrap">
        <% if @record.companion.present? %>
          <span class="bg-white/20 text-white font-semibold px-2.5 py-1 rounded-lg">
            同伴者： <%= @record.companion %>
          </span>
        <% end %>

        <!-- 料金表示 -->
        <% if @record.total_cost.present? %>
          <span class="bg-amber-300 text-slate-900 font-bold px-2.5 py-1 rounded-lg shadow-sm">
            料金： <%= number_to_currency(@record.total_cost, unit: "円", precision: 0, format: "%n%u") %>
          </span>
        <% end %>

        <!-- ティー表示（色別専用バッジ ＆ アイコン） -->
        <% if @record.tee.present? %>
          <%
            tee_config = case @record.tee
              when "レディース", /赤/ then { class: "bg-rose-500 text-white", icon: "🔴" }
              when "ショート", /ピンク/ then { class: "bg-pink-400 text-white", icon: "🌸" }
              when "フロント", /ゴールド/, /緑/ then { class: "bg-amber-400 text-slate-900 font-bold", icon: "🟡" }
              when "レギュラー", /白/ then { class: "bg-white text-slate-800 font-bold border border-slate-300", icon: "⚪️" }
              when "バック", /青/, /黒/ then { class: "bg-slate-900 text-white", icon: "🔵" }
              else { class: "bg-emerald-900 text-white", icon: "⛳️" }
            end
          %>
          <span class="<%= tee_config[:class] %> px-2.5 py-1 rounded-lg text-xs font-semibold shadow-sm flex items-center gap-1">
            <span><%= @record.tee %></span>
            <span><%= tee_config[:icon] %></span>
          </span>
        <% end %>

        <% if @record.pace.present? %>
          <span class="bg-white/10 text-emerald-100 px-2.5 py-1 rounded-lg">進行: <%= @record.pace %></span>
        <% end %>
      </div>
    </div>

    <!-- コンテンツエリア -->
    <div class="p-6 sm:p-8 space-y-6">
      <!-- 満足度 & スコア -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- 満足度 -->
        <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100 flex flex-col justify-center">
          <span class="text-xs text-slate-500 block mb-1 font-semibold">総合満足度</span>
          <%
            satisfaction_labels = {
              "star1" => "不満",
              "star2" => "やや不満",
              "star3" => "普通",
              "star4" => "満足",
              "star5" => "大満足"
            }
            satisfaction_text = satisfaction_labels[@record.satisfaction] || @record.satisfaction
          %>
          <div class="text-amber-500 text-xl font-bold flex items-center gap-1.5">
            <span><%= "⭐️" * @record.satisfaction_before_type_cast.to_i %></span>
            <span class="text-xs text-slate-700 font-bold bg-amber-100 border border-amber-200 px-2 py-0.5 rounded-full ml-1">
              <%= satisfaction_text %>
            </span>
          </div>
        </div>

        <!-- スコア -->
        <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100">
          <span class="text-xs text-slate-500 block mb-1 font-semibold">スコア記録</span>
          <% if @record.score_18h.present? %>
            <div class="flex items-baseline gap-2 mt-1">
              <span class="text-slate-900 font-extrabold text-3xl"><%= @record.score_18h %></span>
              <span class="text-xs font-semibold text-slate-600 bg-slate-200 px-2.5 py-0.5 rounded-full">18H ラウンド</span>
            </div>
          <% elsif @record.score_9h.present? %>
            <div>
              <div class="flex items-center gap-2 mt-1">
                <span class="text-slate-900 font-extrabold text-3xl"><%= @record.score_9h %></span>
                <span class="text-xs font-semibold text-emerald-800 bg-emerald-100 px-2.5 py-0.5 rounded-full">
                  ハーフ (9H)
                </span>
              </div>
              <div class="mt-2 text-xs text-slate-600 bg-white p-2 rounded-xl border border-slate-200">
                <span class="font-bold text-emerald-700">18H換算目安スコア： <%= @record.converted_score_18h %></span>
              </div>
            </div>
          <% else %>
            <span class="text-slate-400 text-sm italic mt-1 block">スコア未入力</span>
          <% end %>
        </div>
      </div>

      <!-- 料金プラン ＆ 食事 -->
      <div class="border-t border-slate-100 pt-5 space-y-3">
        <h2 class="text-sm font-bold text-slate-800">
          料金プラン ＆ 食事
        </h2>

        <% if @record.total_cost.present? || @record.cost_memo.present? || @record.plan_options.present? %>
          <div class="bg-emerald-50/40 border border-emerald-100 rounded-xl p-3 text-xs text-slate-700 space-y-1.5">
            <% if @record.total_cost.present? %>
              <p><strong class="text-emerald-900">料金：</strong> <%= number_to_currency(@record.total_cost, unit: "円", precision: 0, format: "%n%u") %></p>
            <% end %>
            <% if @record.plan_options.present? %>
              <p><strong class="text-emerald-900">プラン：</strong> <%= Array.wrap(@record.plan_options).reject(&:blank?).join(" / ") %></p>
            <% end %>
            <% if @record.cost_memo.present? %>
              <p><strong class="text-emerald-900">プランメモ：</strong> <%= @record.cost_memo %></p>
            <% end %>
          </div>
        <% end %>

        <% if @record.food_rating.present? || @record.food_memo.present? %>
          <div class="bg-amber-50/50 border border-amber-100 rounded-xl p-3 text-xs text-slate-700 space-y-1">
            <p><strong class="text-amber-900">レストラン評価：</strong> <%= @record.food_rating.presence || "未設定" %></p>
            <% if @record.food_memo.present? %>
              <p><strong class="text-amber-900">食事メモ：</strong> <%= @record.food_memo %></p>
            <% end %>
          </div>
        <% end %>
      </div>

      <!-- プレースタイル ＆ 系列 -->
      <% if @record.play_style.present? || @record.brand.present? %>
        <div class="border-t border-slate-100 pt-5 space-y-2">
          <h2 class="text-sm font-bold text-slate-800">
            プレースタイル ＆ 系列
          </h2>
          <div class="flex items-center gap-2 text-xs text-slate-700 flex-wrap">
            <% if @record.play_style.present? %>
              <span class="bg-slate-100 px-3 py-1 rounded-lg">スタイル： <strong><%= @record.play_style %></strong></span>
            <% end %>
            <% if @record.brand.present? %>
              <span class="bg-slate-100 px-3 py-1 rounded-lg">系列・ブランド： <strong><%= @record.brand %></strong></span>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- コースの特徴・難易度 -->
      <div class="border-t border-slate-100 pt-5">
        <h2 class="text-sm font-bold text-slate-800 mb-3">
          コースの特徴・難易度
        </h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-center mb-3">
          <div class="bg-emerald-50/50 p-2.5 rounded-xl border border-emerald-100/60">
            <span class="text-[11px] text-slate-500 block">総合難易度</span>
            <span class="text-xs font-bold text-emerald-900"><%= @record.difficulty.presence || "未設定" %></span>
          </div>
          <div class="bg-emerald-50/50 p-2.5 rounded-xl border border-emerald-100/60">
            <span class="text-[11px] text-slate-500 block">コース広さ</span>
            <span class="text-xs font-bold text-emerald-900"><%= @record.course_width.presence || "未設定" %></span>
          </div>
          <div class="bg-emerald-50/50 p-2.5 rounded-xl border border-emerald-100/60">
            <span class="text-[11px] text-slate-500 block">OB出やすさ</span>
            <span class="text-xs font-bold text-emerald-900"><%= @record.ob_risk.presence || "未設定" %></span>
          </div>
          <div class="bg-emerald-50/50 p-2.5 rounded-xl border border-emerald-100/60">
            <span class="text-[11px] text-slate-500 block">フェアウェイ</span>
            <span class="text-xs font-bold text-emerald-900"><%= @record.fairway.presence || "未設定" %></span>
          </div>
        </div>

        <div class="bg-slate-50 p-3.5 rounded-xl space-y-2 text-xs text-slate-700">
          <% if @record.bunker_difficulty.present? %>
            <p><strong class="text-slate-900">バンカー：</strong> <%= @record.bunker_difficulty %></p>
          <% end %>
          <% if @record.hazard.present? %>
            <p><strong class="text-slate-900">池・谷・崖：</strong> <%= @record.hazard %></p>
          <% end %>
          <% if @record.green_features.present? %>
            <p><strong class="text-slate-900">グリーン傾向：</strong> <%= Array.wrap(@record.green_features).reject(&:blank?).join(" / ") %></p>
          <% end %>
          <% if @record.green_memo.present? %>
            <p><strong class="text-slate-900">グリーン補足：</strong> <%= @record.green_memo %></p>
          <% end %>
        </div>
      </div>

      <!-- 施設・設備 -->
      <div class="border-t border-slate-100 pt-5">
        <h2 class="text-sm font-bold text-slate-800 mb-3">
          施設・設備
        </h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-center mb-3">
          <div class="bg-slate-50 p-2.5 rounded-xl border border-slate-100">
            <span class="text-[11px] text-slate-500 block">コース内トイレ</span>
            <span class="text-xs font-bold text-slate-800"><%= @record.toilet_rating.presence || "未設定" %></span>
          </div>
          <div class="bg-slate-50 p-2.5 rounded-xl border border-slate-100">
            <span class="text-[11px] text-slate-500 block">カート</span>
            <span class="text-xs font-bold text-slate-800"><%= @record.cart_type.presence || "未設定" %></span>
          </div>
          <div class="bg-slate-50 p-2.5 rounded-xl border border-slate-100">
            <span class="text-[11px] text-slate-500 block">コースメンテ</span>
            <span class="text-xs font-bold text-slate-800"><%= @record.maintenance.presence || "未設定" %></span>
          </div>
          <div class="bg-slate-50 p-2.5 rounded-xl border border-slate-100">
            <span class="text-[11px] text-slate-500 block">スタッフ接客</span>
            <span class="text-xs font-bold text-slate-800"><%= @record.service.presence || "未設定" %></span>
          </div>
        </div>

        <div class="space-y-2 text-xs text-slate-700">
          <% if @record.driving_range.present? %>
            <p class="bg-slate-50 p-2.5 rounded-xl border border-slate-100"><strong class="text-slate-900">練習場：</strong> <%= Array.wrap(@record.driving_range).reject(&:blank?).join(" / ") %></p>
          <% end %>
          <% if @record.bath_features.present? || @record.bath_memo.present? %>
            <div class="bg-sky-50/50 p-2.5 rounded-xl border border-sky-100 space-y-1">
              <% if @record.bath_features.present? %>
                <% formatted_baths = Array.wrap(@record.bath_features).reject(&:blank?).map { |item| item == "高級ドライヤー" ? "高級ドライヤー(ReFa等)あり" : item } %>
                <p><strong class="text-sky-900">お風呂設備：</strong> <%= formatted_baths.join(" / ") %></p>
              <% end %>
              <% if @record.bath_memo.present? %>
                <p><strong class="text-sky-900">お風呂メモ：</strong> <%= @record.bath_memo %></p>
              <% end %>
            </div>
          <% end %>
          <% if @record.shop_memo.present? %>
            <p class="bg-slate-50 p-2.5 rounded-xl border border-slate-100"><strong class="text-slate-900">売店・自販機：</strong> <%= @record.shop_memo %></p>
          <% end %>
        </div>
      </div>

      <!-- メモ・振り返り -->
      <div class="border-t border-slate-100 pt-5">
        <h2 class="text-sm font-bold text-slate-800 mb-2">メモ・振り返り</h2>
        <div class="bg-amber-50/60 border border-amber-100 rounded-2xl p-4 text-slate-700 leading-relaxed text-sm whitespace-pre-wrap">
          <% if @record.memo.present? %>
            <%= @record.memo %>
          <% else %>
            <span class="text-slate-400 italic">メモはありません</span>
          <% end %>
        </div>
      </div>

      <!-- ボタン枠 -->
      <div class="border-t border-slate-100 pt-6 flex items-center justify-between">
        <%= link_to "← 一覧へ戻る", records_path, class: "px-4 py-2.5 text-sm text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-xl transition font-medium" %>
        <div class="flex items-center gap-3">
          <%= link_to "✏️ 編集する", edit_record_path(@record), class: "px-4 py-2.5 text-sm font-bold text-white bg-emerald-700 hover:bg-emerald-800 rounded-xl shadow transition" %>
          <%= link_to "🗑️ 削除する", record_path(@record),
                      data: { turbo_method: :delete, turbo_confirm: "本当にこのカルテを削除しますか？" },
                      class: "px-4 py-2.5 text-sm font-bold text-red-600 bg-red-50 hover:bg-red-100 rounded-xl border border-red-200 transition cursor-pointer" %>
        </div>
      </div>
    </div>
  </div>
</div>