<header style="background-color: #2d6a4f; color: white; padding: 15px 30px; display: flex; justify-content: space-between; align-items: center;">
  <!-- ロゴ（Josefin Sans を指定 ＆ 文字間隔を少し調整） -->
  <div style="font-size: 24px; font-weight: bold;">
    <%= link_to root_path, style: "color: white; text-decoration: none; font-family: 'Josefin Sans', sans-serif; letter-spacing: 1px;" do %>
      ⛳️ gollog
    <% end %>
  </div>

  <!-- ナビゲーションメニュー（ログイン状態で切り替え） -->
  <nav>
    <ul style="list-style: none; display: flex; align-items: center; gap: 20px; margin: 0; padding: 0;">
      <% if user_signed_in? %>
        <!-- 🔓 ログイン中の表示 -->
        <li style="font-size: 14px; opacity: 0.9;">
          👤 <%= current_user.name.presence || "ゲストゴルファー" %> さん
        </li>
        <li>
          <%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete }, style: "color: white; text-decoration: none; font-size: 14px; border: 1px solid rgba(255,255,255,0.6); padding: 5px 12px; border-radius: 4px;" %>
        </li>
      <% else %>
        <!-- 🔐 未ログイン時の表示 -->
        <li>
          <%= link_to "新規登録", new_user_registration_path, style: "color: #2d6a4f; background-color: white; text-decoration: none; font-size: 14px; font-weight: bold; padding: 6px 14px; border-radius: 4px;" %>
        </li>
        <li>
          <%= link_to "ログイン", new_user_session_path, style: "color: white; text-decoration: none; font-size: 14px; border: 1px solid rgba(255,255,255,0.6); padding: 5px 12px; border-radius: 4px;" %>
        </li>
      <% end %>
    </ul>
  </nav>
</header>