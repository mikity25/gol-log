<header class="bg-[#2d6a4f] text-white px-3 sm:px-6 py-3 flex justify-between items-center shadow-sm">
  <!-- ロゴ（SVGフラッグ + テキスト） -->
  <div class="shrink-0">
    <%= link_to root_path, class: "text-white no-underline flex items-center gap-1.5 sm:gap-2 hover:opacity-90 transition-opacity" do %>
      <svg class="w-5 h-5 sm:w-6 sm:h-6 text-emerald-200 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 18v-15l7 4l-7 4" />
        <path d="M9 17.67c-.62 .36 -1 .82 -1 1.33c0 1.1 1.8 2 4 2s4 -.9 4 -2c0 -.5 -.38 -.97 -1 -1.33" />
      </svg>
      <span class="font-['Josefin_Sans'] text-lg sm:text-xl font-bold tracking-wider">gollog</span>
    <% end %>
  </div>

  <!-- ナビゲーションメニュー -->
  <nav>
    <ul class="list-none flex items-center gap-1.5 sm:gap-3.5 m-0 p-0">
      <% if user_signed_in? %>
        <li>
          <%= link_to "一覧", records_path, class: "text-white no-underline text-xs sm:text-sm opacity-90 hover:opacity-100 whitespace-nowrap px-1 py-1" %>
        </li>
        <li>
          <%= link_to "+ 新規", new_record_path, class: "text-[#2d6a4f] bg-white no-underline text-xs sm:text-sm font-bold px-2 sm:px-3.5 py-1 sm:py-1.5 rounded-md hover:bg-emerald-50 transition-colors whitespace-nowrap shadow-xs" %>
        </li>
        <li>
          <%= link_to "設定", edit_user_registration_path, class: "text-white no-underline text-xs sm:text-sm opacity-90 hover:opacity-100 whitespace-nowrap px-1 py-1" %>
        </li>
        <li>
          <%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete }, class: "text-white no-underline text-xs sm:text-sm border border-white/60 px-1.5 sm:px-3 py-1 rounded-md hover:bg-white/10 transition-colors whitespace-nowrap" %>
        </li>
      <% else %>
        <li>
          <%= link_to "新規登録", new_user_registration_path, class: "text-[#2d6a4f] bg-white no-underline text-xs sm:text-sm font-bold px-2.5 sm:px-3.5 py-1 sm:py-1.5 rounded-md hover:bg-emerald-50 transition-colors whitespace-nowrap" %>
        </li>
        <li>
          <%= link_to "ログイン", new_user_session_path, class: "text-white no-underline text-xs sm:text-sm border border-white/60 px-2 sm:px-3 py-1 rounded-md hover:bg-white/10 transition-colors whitespace-nowrap" %>
        </li>
      <% end %>
    </ul>
  </nav>
</header>