<!-- メインヒーローセクション -->
<section style="background: linear-gradient(180deg, #f0fdf4 0%, #ffffff 100%); text-align: center; padding: clamp(48px, 8vw, 80px) 20px 40px; border-bottom: 1px solid #e2e8f0;">
  <div style="max-width: 720px; margin: 0 auto;">
    
    <!-- サブキャッチ 1 -->
    <p style="font-size: clamp(14px, 3.5vw, 16px); color: #2d6a4f; font-weight: 700; letter-spacing: 0.05em; margin: 0 0 8px 0;">
      自分視点の本音メモで、次のコース選びを最適化
    </p>

    <!-- サブキャッチ 2 -->
    <p style="font-size: clamp(16px, 4vw, 20px); color: #334155; font-weight: 700; margin: 0 0 20px 0;">
      自分専用 ゴルフ場カルテ
    </p>

    <!-- メインロゴ（レスポンシブ特大表示） -->
    <h1 style="font-family: 'Josefin Sans', sans-serif; font-size: clamp(44px, 12vw, 68px); font-weight: 700; color: #2d6a4f; letter-spacing: 2px; line-height: 1.1; margin: 0 0 32px 0;">
      gollog
    </h1>

    <!-- ユーザー状態に応じたアクションボタン -->
    <div style="display: flex; justify-content: center; gap: 14px; flex-wrap: wrap; margin-bottom: 12px;">
      <% if user_signed_in? %>
        <%= link_to "カルテ一覧を見る", records_path, style: "background-color: #2d6a4f; color: #ffffff; padding: 14px 28px; border-radius: 8px; text-decoration: none; font-size: 15px; font-weight: bold; display: inline-block; box-shadow: 0 4px 10px rgba(45, 106, 79, 0.25); min-width: 180px;" %>
        <%= link_to "+ 新規カルテ作成", new_record_path, style: "background-color: #ffffff; color: #2d6a4f; border: 2px solid #2d6a4f; padding: 12px 26px; border-radius: 8px; text-decoration: none; font-size: 15px; font-weight: bold; display: inline-block; min-width: 180px;" %>
      <% else %>
        <%= link_to "無料ではじめる（新規登録）", new_user_registration_path, style: "background-color: #2d6a4f; color: #ffffff; padding: 14px 28px; border-radius: 8px; text-decoration: none; font-size: 15px; font-weight: bold; display: inline-block; box-shadow: 0 4px 10px rgba(45, 106, 79, 0.25); min-width: 200px;" %>
        <%= link_to "ログイン", new_user_session_path, style: "background-color: #ffffff; color: #2d6a4f; border: 2px solid #2d6a4f; padding: 12px 26px; border-radius: 8px; text-decoration: none; font-size: 15px; font-weight: bold; display: inline-block; min-width: 120px;" %>
      <% end %>
    </div>

  </div>
</section>

<!-- サービスの特徴セクション -->
<section style="max-width: 960px; margin: 50px auto 60px; padding: 0 20px;">
  <div style="text-align: center; margin-bottom: 40px;">
    <h2 style="font-size: clamp(20px, 5vw, 24px); font-weight: 700; color: #1e293b; margin: 0 0 8px 0;">
      <span style="font-family: 'Josefin Sans', sans-serif; color: #2d6a4f;">gollog</span> の特徴
    </h2>
    <p style="font-size: 13px; color: #64748b; margin: 0;">シンプルに、あなたのためのゴルフ記録を残す</p>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px;">
    
    <!-- 特徴 1 -->
    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 24px; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);">
      <div style="display: inline-block; font-family: 'Josefin Sans', sans-serif; font-size: 13px; font-weight: 700; color: #2d6a4f; background: #e8f5e9; padding: 4px 10px; border-radius: 4px; margin-bottom: 14px;">
        01
      </div>
      <h3 style="font-size: 16px; font-weight: 700; color: #1e293b; margin: 0 0 8px 0;">自分視点の本音メモ</h3>
      <p style="font-size: 13px; color: #64748b; line-height: 1.6; margin: 0;">
        コースの難易度やグリーンの速さ、食事の満足度など、公の口コミには書けない率直な感想を記録できます。
      </p>
    </div>

    <!-- 特徴 2 -->
    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 24px; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);">
      <div style="display: inline-block; font-family: 'Josefin Sans', sans-serif; font-size: 13px; font-weight: 700; color: #2d6a4f; background: #e8f5e9; padding: 4px 10px; border-radius: 4px; margin-bottom: 14px;">
        02
      </div>
      <h3 style="font-size: 16px; font-weight: 700; color: #1e293b; margin: 0 0 8px 0;">次のコース選びを最適化</h3>
      <p style="font-size: 13px; color: #64748b; line-height: 1.6; margin: 0;">
        「前回の印象はどうだったか」をラウンド前に素早く振り返り、リピートやコース選定の判断材料にできます。
      </p>
    </div>

    <!-- 特徴 3 -->
    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 24px; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);">
      <div style="display: inline-block; font-family: 'Josefin Sans', sans-serif; font-size: 13px; font-weight: 700; color: #2d6a4f; background: #e8f5e9; padding: 4px 10px; border-radius: 4px; margin-bottom: 14px;">
        03
      </div>
      <h3 style="font-size: 16px; font-weight: 700; color: #1e293b; margin: 0 0 8px 0;">蓄積される専用データベース</h3>
      <p style="font-size: 13px; color: #64748b; line-height: 1.6; margin: 0;">
        カルテが増えるほど、あなた専用のコースデータが蓄積され、ゴルフライフの振り返りがより楽しくなります。
      </p>
    </div>

  </div>
</section>